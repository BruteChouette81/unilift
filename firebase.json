{
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": [
    {
      "database": "uniliftdefault",
      "rules": "firestore.rules"
    },
    {
      "database": "uniliftdev",
      "rules": "firestore.dev.rules"
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "live",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint"
      ]
    },
    {
      "source": "functions-sandbox",
      "codebase": "sandbox",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint"
      ]
    }
  ]
}
