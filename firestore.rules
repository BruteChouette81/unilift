rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────────
    // Fields that only Cloud Functions (admin SDK) may write.
    // Client requests that touch any of these are rejected.
    function isFinancialField(key) {
      return key in [
        'pendingChargeCents', 'pendingEarningsCents',
        'stripeCustomerId', 'stripePaymentMethodId',
        'stripePaymentMethodLast4', 'stripePaymentMethodBrand'
      ];
    }

    // Used in create rules: resource is null so we can't diff — check incoming keys directly.
    function newDocHasFinancialFields() {
      return request.resource.data.keys().hasAny([
        'pendingChargeCents', 'pendingEarningsCents',
        'stripeCustomerId', 'stripePaymentMethodId',
        'stripePaymentMethodLast4', 'stripePaymentMethodBrand'
      ]);
    }

    // Used in update rules: diff against the existing doc to catch only changed fields.
    function touchesFinancialFields() {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny([
          'pendingChargeCents', 'pendingEarningsCents',
          'stripeCustomerId', 'stripePaymentMethodId',
          'stripePaymentMethodLast4', 'stripePaymentMethodBrand'
        ]);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isRideDriver(rideData) {
      return rideData.driverId == request.auth.uid;
    }

    // Founder admin: gated by a Firebase Auth custom claim ({ admin: true }) set
    // on the founder accounts via functions/scripts/set-admin-claims.js. Used by
    // the founder-only admin dashboard to edit config collections (events).
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ── Users ──────────────────────────────────────────────────────────────────
    match /users/{uid} {

      // Any signed-in user can read public profile fields (needed for ride cards,
      // passenger profile modals, driver info, etc.)
      allow read: if isSignedIn();

      // A user can create their own document (sign-up flow).
      allow create: if isSignedIn() && isOwner(uid) && !newDocHasFinancialFields();

      // A user can update their own document but cannot touch financial fields —
      // those are exclusively managed by Cloud Functions via the admin SDK.
      allow update: if isSignedIn() && isOwner(uid) && !touchesFinancialFields();

      // Any signed-in user may update ONLY the ratings/XP/ridesCompleted fields
      // on another user's document. This supports the post-ride rating flow where
      // a passenger writes the driver's rating from the client.
      // TODO: Migrate updateRatings() and updateXP() to a Cloud Function so this
      //       rule can be tightened to require the caller was on the ride.
      allow update: if isSignedIn()
        && !isOwner(uid)
        && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['ratings', 'ratingWeigth', 'xp', 'ridesCompleted']);

      allow delete: if false;
    }

    // Transactions subcollection — a user may only read their own; all writes are
    // Cloud Function–only (admin SDK bypasses these rules entirely).
    match /users/{uid}/transactions/{txId} {
      allow read: if isSignedIn() && isOwner(uid);
      allow write: if false;
    }

    // ── Rides ──────────────────────────────────────────────────────────────────
    match /rides/{rideId} {

      // Fields that decide who gets paid, how much, and whether the ride is over.
      // Every one of these is written exclusively by the Cloud Functions, which
      // use the admin SDK and bypass these rules entirely — so denying all client
      // writes here costs the server nothing.
      //
      // This list is the whole point of the dropoff-radius fix: a driver used to
      // be able to PATCH confirmedDropoffPassengers directly and then call
      // /rides/finish, collecting a fare for a passenger dropped nowhere near
      // their destination. Adding a field here is the correct reflex whenever a
      // new field starts feeding billing.
      function touchesRideMoneyFields() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'driverId',
          'paymentStatus',
          'boardedPassengers',
          'droppedPassengers',
          'confirmedDropoffPassengers',
          'dropoffDistanceKm',
          'dropoffDriverLocation',
          'dropoffAt',
          'pendingRatings',
          'ratingsSubmitted',
          'pendingConfirmation',
          'confirmDeadlineAt',
          'requestId',
          'started',
          'startedAt'
        ]);
      }

      // Pickup/dropoff coordinates ARE billing inputs: /rides/finish prices the
      // leg as passengerPickups[pid] → destinationCoords, and /rides/dropoff
      // range-checks the driver against passengerDropoffs[pid]. They may only be
      // written while the ride is still `planned` — once it starts, they freeze.
      // `.get()` with a default so a legacy doc missing `status` doesn't hard-deny
      // (a missing key would otherwise abort rule evaluation).
      function isPlannedRide() {
        return resource.data.get('status', 'planned') == 'planned';
      }

      // Any signed-in user can read rides (home screen, explore tab, etc.)
      allow read: if isSignedIn();

      // Only the driver can create the ride; driverId must equal the caller's uid.
      allow create: if isSignedIn()
        && request.resource.data.driverId == request.auth.uid;

      allow update: if isSignedIn()
        && !touchesRideMoneyFields()
        && (

          // ── Driver GPS telemetry ─────────────────────────────────────────────
          // services/rideServices.ts updateDriverLocation(). Feeds the passenger's
          // live map ONLY. The dropoff radius check reads a fresh fix supplied in
          // the /rides/dropoff request body, not this field.
          (isRideDriver(resource.data)
            && request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasOnly(['driverLocation']))

          ||

          // ── Driver accepts / rejects a join request ───────────────────────────
          // services/rideServices.ts respondToJoinRequest(), called from
          // app/riderScreen.tsx. Planned rides only — see isPlannedRide().
          // TODO: move to POST /rides/respond-join, then delete this clause and
          //       this block collapses to the firestore.dev.rules version.
          (isRideDriver(resource.data)
            && isPlannedRide()
            && request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasOnly([
                    'passengers',
                    'seatsAvailable',
                    'joinRequests',
                    'passengerSeats',
                    'passengerPickups',
                    'passengerDropoffs'
                  ]))

          ||

          // ── Join-request send / cancel ───────────────────────────────────────
          // Any signed-in user may send or cancel a join request. Only
          // joinRequests is allowed here — the passengers array and seatsAvailable
          // are mutated exclusively by the driver (clause above), so a passenger
          // cannot quit an accepted ride or remove another passenger this way.
          (request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['joinRequests']))

          ||

          // ── Lazy client-side expiry of a stale ride ──────────────────────────
          // cleanupExpiredRide / cleanupAbandonedStartedRide, called from
          // app/(tabs)/index.tsx. Terminal and one-way: only ever writes
          // status:"expired", never re-opens a ride, and cannot touch money fields
          // (guarded above).
          // TODO: delete once sweepStaleRides runs against uniliftdefault — today
          //       TARGET_DB = devDb (functions/index.js), so production has NO
          //       server-side expiry and this clause is load-bearing.
          (request.resource.data.get('status', '') == 'expired'
            && request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasOnly(['status', 'passengers', 'joinRequests']))
        );

      // Rides are never hard-deleted from the client — they are marked expired.
      allow delete: if false;
    }

    // ── Ride Requests ───────────────────────────────────────────────────────────
    // Passenger-created planned trips ("queue a ride in advance"). The passenger
    // owns the request fully; drivers (future phase) only read them.
    match /rideRequests/{requestId} {

      // Any signed-in user can read (drivers will browse open requests later).
      allow read: if isSignedIn();

      // Only the passenger can create their own request.
      allow create: if isSignedIn()
        && request.resource.data.passengerId == request.auth.uid;

      // Only the owner can update their request, and they cannot reassign it.
      allow update: if isSignedIn()
        && isOwner(resource.data.passengerId)
        && request.resource.data.passengerId == resource.data.passengerId;

      // The owner may delete (cancel) their own request.
      allow delete: if isSignedIn() && isOwner(resource.data.passengerId);
    }

    // ── Hype Events ──────────────────────────────────────────────────────────────
    // Event catalog for the Hype map. Any signed-in user may read. Writes are
    // restricted to founder admins (custom claim) so the admin dashboard can
    // create/edit/delete events. Regular clients still cannot write.
    // NOTE: attendeeCount (optional "people going" stat) has no dedicated writer
    // after the interest-toggle feature was removed — it's set manually via the
    // admin dashboard like any other event field, subject to the same isAdmin() rule.
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ── Sponsors ─────────────────────────────────────────────────────────────────
    // Paying partner businesses shown on the home map. Any signed-in user may read.
    // Writes are restricted to founder admins (custom claim) so the admin dashboard
    // can create/edit/delete sponsors. Regular clients cannot write.
    match /sponsors/{sponsorId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ── Config ─────────────────────────────────────────────────────────────────
    // App-wide editable config (e.g. `config/pricing` — ride per-km rates). Any
    // signed-in user may read (app + Cloud Function need the values); only
    // founder admins (custom claim) may write, via the admin dashboard.
    match /config/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Driver Sessions ─────────────────────────────────────────────────────────
    // A driver's live "online to drive" state. Doc id == driver uid. Readable by
    // any signed-in user (so dispatch/matching can see online drivers); only the
    // owner may write their own session.
    match /driverSessions/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && isOwner(uid)
        && request.resource.data.driverId == request.auth.uid;
      allow delete: if isSignedIn() && isOwner(uid);
    }
  }
}
